# Seam environment variables
# NOTE: This app does not auto-load .env.
# Export these in your shell before launching if needed.

# Optional: OpenAI provider
OPENAI_API_KEY=

# Optional: Anthropic provider
ANTHROPIC_API_KEY=

# Optional: Hugging Face token for pyannote diarization
HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# Optional: override Ollama host used by ollama CLI/runtime
# Example: 127.0.0.1:11434
OLLAMA_HOST=
