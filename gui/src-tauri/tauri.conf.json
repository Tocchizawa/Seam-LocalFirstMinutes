{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seam",
  "version": "0.2.0-beta.5",
  "identifier": "com.seamapp.seam",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Seam",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "resources/uv": "uv",
      "resources/seam-backend.tar.gz": "seam-backend.tar.gz",
      "resources/audio-capture": "audio-capture"
    }
  }
}
